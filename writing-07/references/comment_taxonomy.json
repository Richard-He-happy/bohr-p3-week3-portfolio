{
  "vocab_version": "1.0.0",
  "intro": "Vocabulary and judgement rules shared by the revision workbench. Scripts read only the keys listed here; adding entries is safe and any unknown key is ignored.",
  "decision_to_tone": {
    "accept": "accept",
    "partial": "clarify",
    "reject": "polite_rebuttal",
    "clarify": "clarify",
    "invalid": "appeal"
  },
  "tone_guide": {
    "accept": "agree, name the concrete change, give its locator",
    "clarify": "restate what the baseline really says, then present the change",
    "polite_rebuttal": "acknowledge the concern, present the re-checked evidence, explain why the text stays",
    "appeal": "point out the mismatch factually and note willingness to comply if the editor insists"
  },
  "evidence_states": {
    "provided": "the needed datum or reference already exists in the supplied materials and is cited by locator",
    "not_provided": "the supplied materials do not contain it; state why and never claim it was produced",
    "not_applicable": "the sub-requirement needs no additional evidence"
  },
  "decision_guide": [
    "accept: the change is executable inside the supplied baseline and has actually been made",
    "partial: only part is executable; record the remainder and route it for human confirmation",
    "clarify: the comment misreads the text; restate the baseline before offering a wording change",
    "reject: executing the request would contradict supplied facts; keep the paragraph and show the re-check",
    "invalid: the comment contradicts the baseline (wrong section/number, already handled); state it factually, never drop it silently"
  ],
